<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Rdpl.Timetable.Api</RootNamespace>
    <AssemblyName>Rdpl.Timetable.Api</AssemblyName>
    <!-- Keeps local development secrets out of the repository: dotnet user-secrets set "Api:ApiKey" "..." -->
    <UserSecretsId>rdpl-timetable-api-7c1f2c55</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rdpl.Timetable.Core\Rdpl.Timetable.Core.csproj" />
    <!-- Optional PostgreSQL store (Persistence:Enabled). The Core solver and the CLI do not reference it. -->
    <ProjectReference Include="..\Rdpl.Timetable.Persistence\Rdpl.Timetable.Persistence.csproj" />
  </ItemGroup>

  <!--
    Optional Azure Key Vault configuration provider.
    Build with:  dotnet build -p:EnableKeyVault=true
    Then set KeyVault:Uri (e.g. env var KeyVault__Uri). Uses DefaultAzureCredential (managed identity in Azure).
    Not compiled by default so the API builds without Azure dependencies.
  -->
  <PropertyGroup Condition="'$(EnableKeyVault)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_KEY_VAULT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableKeyVault)' == 'true'">
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
